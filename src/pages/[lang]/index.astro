---
// Every non-default language gets its own page here: /pt/, /ja/, ...
// (the default language is src/pages/index.astro, at /). The list comes from
// `languages` in src/i18n/ui.ts, so there is nothing to add per language.
import Portfolio from "../../components/Portfolio.astro";
import { locales, defaultLang } from "../../i18n/ui";

export function getStaticPaths() {
  return locales
    .filter((l) => l !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import ProcessTable from '../components/ProcessTable.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusBar from '../components/StatusBar.astro';
import { site, about, projects, skills } from '../data/portfolio';
---

<Base title={site.title} description={site.description}>
  <TopBar />

  <main class="shell">
    <ProcessTable />

    <section class="viewer" id="viewer" aria-label="Section viewer">
      <div class="viewer__tabs">
        <span class="tab" data-tab-label>PID 001 – about</span>
      </div>

      <div class="viewer__body">
        <!-- 001 about -->
        <article class="panel" id="panel-about" data-panel="about">
          <p class="crumb">./about</p>
          <h1>{about.headline}</h1>
          <p class="lead">{about.summary}</p>
          <dl class="facts">
            {
              about.facts.map((f) => (
                <div>
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
        </article>

        <!-- 002 projects -->
        <article class="panel" id="panel-projects" data-panel="projects">
          <header class="panel__head">
            <div>
              <p class="crumb">./projects</p>
              <h2>Systems &amp; Security Work</h2>
            </div>
            <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">View on GitHub ↗</a>
          </header>
          <div class="projects">
            {projects.map((p) => <ProjectCard project={p} />)}
          </div>
        </article>

        <!-- 003 skills -->
        <article class="panel" id="panel-skills" data-panel="skills">
          <p class="crumb">./skills</p>
          <h2>Skills</h2>
          <div class="skills">
            {
              skills.map((g) => (
                <section>
                  <h3>{g.group}</h3>
                  <ul class="chips">
                    {g.items.map((i) => <li>{i}</li>)}
                  </ul>
                </section>
              ))
            }
          </div>
        </article>

        <!-- 004 contact -->
        <article class="panel" id="panel-contact" data-panel="contact">
          <p class="crumb">./contact</p>
          <h2>Contact</h2>
          <p class="lead">Open to internships. The fastest way to reach me is email.</p>
          <ul class="links">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
            <li><a href={site.resume}>Resume (PDF)</a></li>
          </ul>
        </article>
      </div>
    </section>
  </main>

  <StatusBar />

  <script>
    import '../scripts/portfolio';
  </script>
</Base>

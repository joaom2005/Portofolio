---
import '@fontsource-variable/jetbrains-mono';
import '../styles/main.scss';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui, locales, getLang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const lang = getLang(Astro.currentLocale);
const t = ui[lang];

// hreflang links need absolute URLs, so they only render when `site` is set
// in astro.config.mjs.
const alternates = Astro.site
  ? locales.map((l) => ({ l, href: new URL(getRelativeLocaleUrl(l), Astro.site).href }))
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    <title>{title}</title>
    <!-- Progressive enhancement: without JS every section is shown stacked. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body data-ui={JSON.stringify(t.script)}>
    <a class="skip" href="#viewer">{t.skip}</a>
    <slot />
  </body>
</html>

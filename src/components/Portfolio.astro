---
// The whole page. src/pages/index.astro (default language) and src/pages/[lang]/index.astro
// (all other languages) both just render this; the language comes from Astro.currentLocale.
import Base from "../layouts/Base.astro";
import TopBar from "./TopBar.astro";
import ProcessTable from "./ProcessTable.astro";
import ProjectCard from "./ProjectCard.astro";
import StatusBar from "./StatusBar.astro";
import { site, getContent } from "../data/portfolio";
import { ui, getLang } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const { title, description, resume, about, projects, skills } = getContent(lang);
---

<Base title={title} description={description}>
  <TopBar />

  <main class="shell">
    <ProcessTable />

    <section class="viewer" id="viewer" aria-label={t.viewer.label}>
      <div
        class="viewer__tabs"
        data-tab-list
        role="tablist"
        aria-label={t.viewer.tabs}
      >
        <!-- Tabs will be generated by portfolio.ts -->
      </div>

      <div class="viewer__body">
        <p class="viewer__empty" data-tab-empty hidden>
          {t.viewer.empty}
        </p>
        <!-- 001 about -->
        <article class="panel" id="panel-about" data-panel="about">
          <p class="crumb">./about</p>
          <h1>{about.headline}</h1>
          <p class="lead">{about.summary}</p>
          <dl class="facts">
            {
              about.facts.map((f) => (
                <div>
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
        </article>

        <!-- 002 projects -->
        <article class="panel" id="panel-projects" data-panel="projects">
          <header class="panel__head">
            <div>
              <p class="crumb">./projects</p>
              <h2>{t.projectsTitle}</h2>
            </div>
            <a
              class="btn"
              href={site.github}
              target="_blank"
              rel="noopener noreferrer">{t.viewGithub}</a
            >
          </header>
          <div class="projects">
            {projects.map((p) => <ProjectCard project={p} />)}
          </div>
        </article>

        <!-- 003 skills -->
        <article class="panel" id="panel-skills" data-panel="skills">
          <p class="crumb">./skills</p>
          <h2>{t.skillsTitle}</h2>
          <div class="skills">
            {
              skills.map((g) => (
                <section>
                  <h3>{g.group}</h3>
                  <ul class="chips">
                    {g.items.map((i) => (
                      <li>{i}</li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>
        </article>

        <!-- 004 contact -->
        <article class="panel" id="panel-contact" data-panel="contact">
          <p class="crumb">./contact</p>
          <h2>{t.contactTitle}</h2>
          <p class="lead">{t.contactLead}</p>
          <ul class="links">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li>
              <a href={site.github} target="_blank" rel="noopener noreferrer"
                >{t.github}</a
              >
            </li>
            <li><a href={resume}>{t.topbar.resume}</a></li>
          </ul>
        </article>
      </div>
    </section>
  </main>

  <StatusBar />

  <script>
    import "../scripts/portfolio";
  </script>
</Base>

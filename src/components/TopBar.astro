---
import { Icon } from "astro-icon/components";
import LangSwitcher from "./LangSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site, getContent } from "../data/portfolio";
import { ui, getLang } from "../i18n/ui";

const lang = getLang(Astro.currentLocale); // "en" on /, "pt" on /pt/
const t = ui[lang];
const { resume } = getContent(lang);
---

<header class="topbar">
  <span class="topbar__prompt"
    ><span class="topbar__logo" aria-hidden="true">&gt;_</span>{
      site.name
    }@portfolio:~</span
  >
  <nav class="topbar__right" aria-label={t.topbar.siteTools}>
    <span class="topbar__version"
      ><span class="dot dot--ok" aria-hidden="true"></span>{t.topbar.portfolio} {
        site.version
      }</span
    > |
    <button
      type="button"
      class="toggle"
      data-inspector-toggle
      aria-pressed="false"
    >
      <span class="toggle__ring" aria-hidden="true"></span>
      {t.topbar.inspector}: <span data-inspector-label>{t.topbar.off}</span>
    </button> |
    <a class="topbar__link" href={resume} data-resume
      ><Icon name="mdi:tray-arrow-down" /> {t.topbar.resume}</a
    > |
    <ThemeToggle /> |
    <LangSwitcher />
  </nav>
</header>

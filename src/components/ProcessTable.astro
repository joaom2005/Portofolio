---
import { processes } from "../data/portfolio";
import { Icon } from "astro-icon/components";
---

<aside class="procs" aria-label="Sections">
  <p class="procs__cmd">
    <span class="procs__dollar">$</span> ./portfolio --inspect
  </p>
  <table class="procs__table">
    <thead>
      <tr>
        <th scope="col">PID</th>
        <th scope="col">NAME</th>
        <th scope="col">STATE</th>
        <th scope="col" class="procs__desc-head">DESCRIPTION</th>
      </tr>
    </thead>
    <tbody>
      {
        processes.map((p) => (
          <tr data-proc={p.id}>
            <td>{p.pid}</td>
            <td>
              <a href={`#${p.id}`} data-proc-link={p.id}>
                {p.id}
              </a>
            </td>
            <td class={`state state--${p.state}`}>{p.state}</td>
            <td class="procs__desc">{p.desc}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="procs__hint">
    <Icon name="mdi:information" /> Click a process to view details…
  </p>
</aside>

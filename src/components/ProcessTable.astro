---
import { getContent } from "../data/portfolio";
import { ui, getLang } from "../i18n/ui";
import { Icon } from "astro-icon/components";

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const { processes } = getContent(lang);
---

<aside class="procs" aria-label={t.procs.label}>
  <p class="procs__cmd">
    <span class="procs__dollar">$</span> ./portfolio --inspect
  </p>
  <table class="procs__table">
    <thead>
      <tr>
        <th scope="col">{t.procs.pid}</th>
        <th scope="col">{t.procs.name}</th>
        <th scope="col">{t.procs.state}</th>
        <th scope="col" class="procs__desc-head">{t.procs.desc}</th>
      </tr>
    </thead>
    <tbody>
      {
        processes.map((p) => (
          <tr data-proc={p.id}>
            <td>{p.pid}</td>
            <td>
              <a href={`#${p.id}`} data-proc-link={p.id}>
                {p.id}
              </a>
            </td>
            <td class={`state state--${p.state}`}>{p.state}</td>
            <td class="procs__desc">{p.desc}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="procs__hint">
    <Icon name="mdi:information" /> {t.procs.hint}
  </p>
</aside>

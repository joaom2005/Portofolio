---
import type { Project } from '../data/portfolio';
import { ui, getLang } from '../i18n/ui';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const t = ui[getLang(Astro.currentLocale)];
---

<article class="project">
  <header class="project__head">
    <h3>{project.title}</h3>
    <a class="btn btn--small" href={project.repo} target="_blank" rel="noopener noreferrer">
      {t.repo}
    </a>
  </header>
  <p class="project__summary">{project.summary}</p>

  <div class="project__shots">
    {
      project.images.map((img) => (
        <img src={img.src} alt={img.alt} width="900" height="500" loading="lazy" decoding="async" />
      ))
    }
  </div>

  <ul class="chips" aria-label={t.technologies}>
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <ul class="project__list">
    {project.highlights.map((h) => <li>{h}</li>)}
  </ul>

  <!-- Inspector mode only -->
  <div class="inspect-only errata">
    <h4><span aria-hidden="true">[errata]</span> {t.errata}</h4>
    <ul>
      {project.errata.map((e) => <li>{e}</li>)}
    </ul>
  </div>
</article>

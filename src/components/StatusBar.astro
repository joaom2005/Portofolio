---
import { site, getContent } from '../data/portfolio';
import { ui, getLang } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const { resume } = getContent(lang);
---

<footer class="statusbar">
  <p class="statusbar__mode" aria-live="polite">
    <span class="dot dot--ok" aria-hidden="true"></span>
    <strong data-mode-name>{t.script.normalName}</strong>
    <span data-mode-text>{t.script.normalText}</span>
  </p>
  <p class="statusbar__keys">
    <button type="button" class="key-btn" data-inspector-toggle-key><kbd>I</kbd> {t.status.toggleInspector}</button>
    <a class="key-btn" href={resume}><kbd>R</kbd> {t.status.openResume}</a>
  </p>
  <a class="btn" href={`mailto:${site.email}`}>{t.status.getInTouch}</a>
</footer>
